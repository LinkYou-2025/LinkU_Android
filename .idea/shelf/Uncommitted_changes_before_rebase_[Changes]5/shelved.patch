+import com.example.file.ui.theme.Gray500
+import com.example.file.ui.theme.MainColor
+import com.example.file.ui.theme.White
+
+@Composable
+fun TopFolderListLayout() {
+
+    // 레이아웃의 배경틀
+    Surface(
+        modifier = Modifier
+            // 가로 111.28947dp, 세로 35dp로 전체 크기 지정
+            .size(width = 111.28947.dp, height = 35.dp),
+
+        // 배경색 (White)
+        color = White,
+
+        // 모서리 둥글게 (14dp)
+        shape = RoundedCornerShape(14.dp),
+    ) {
+
+        // 내부 배치 레이아웃
+        Row(
+            modifier = Modifier
+                // 전체 영역을 가득 채우도록
+                .fillMaxSize()
+
+                // 내부 여백 (양 옆 15dp)
+                .padding(horizontal = 15.dp),
+
+            // 가로 정렬 방법 (요소 간 10dp 간격, 가로 중앙 정렬)
+            horizontalArrangement = Arrangement.spacedBy(10.dp, Alignment.CenterHorizontally),
+
+            // 세로 정렬 방법 (세로 중앙 정렬)
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+
+            // 현재, 상위 폴더명
+            Text(
+                // 텍스트(그라데이션 및 스타일 지정)
+                text = buildAnnotatedString {
+                    withStyle(
+                        SpanStyle(
+                            // 폰트 크기 (16sp)
+                            fontSize = 16.sp,
+
+                            // 사용할 폰트 (paperlogy 폰트)
+                            fontFamily = DefaultFont,
+
+                            // 폰트 굵기 (Bold)
+                            fontWeight = FontWeight.Bold,
+
+                            // 텍스트 그라데이션 색상(링큐 메인 색상)
+                            brush = MainColor,
+                        )
+                    ) {
+                        // 실제 표시할 텍스트
+                        append("나의 폴더")
+                    }
+                },
+
+                // 텍스트 정렬 (정중앙)
+                textAlign = TextAlign.Center,
+
+                // 한 줄 높이 (20sp)
+                lineHeight = 20.sp,
+            )
+
+            // 아래 화살표 모양 아이콘
+            Icon(
+                // 아이콘 색상 (Gray500)
+                tint = Gray500,
+
+                // 사용할 아이콘 이미지 리소스 (drawable/check_img.xml)
+                painter = painterResource(id = R.drawable.check_img),
+
+                // 이미지 설명 ("아래 화살표")
+                contentDescription = "아래 화살표"
+            )
+        }
+    }
+}
+
