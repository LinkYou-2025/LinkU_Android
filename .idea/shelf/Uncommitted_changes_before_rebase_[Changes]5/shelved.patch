+                    .padding(horizontal = 6.dp, vertical = 3.dp),
+                text = tag,
+                // 폰트 크기(10sp)
+                fontSize = 10.sp,
+                // 폰트
+                fontFamily = DefaultFont,
+                // 폰트 굵기(Normal)
