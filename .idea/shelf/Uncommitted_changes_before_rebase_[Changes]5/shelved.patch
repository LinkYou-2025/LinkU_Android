+                    .clip(RoundedCornerShape(18.dp))
+                    .size(157.dp)
+                    .align(Alignment.CenterHorizontally),
+                // 사용할 이미지 리소스
+                painter = painterResource(id = R.drawable.test_img),  // 테스트 이미지
+                contentDescription = null
+            )
+
+            // (2) 링크 제목
+            Text(
+                // 위쪽 여백(10dp)
+                modifier = Modifier
+                    .padding(top = 10.dp),
+                text = "제목",
+                // 폰트 크기(15sp)
+                fontSize = 15.sp,
+                // 폰트
+                fontFamily = DefaultFont,
+                // 폰트 굵기(Medium, 500)
